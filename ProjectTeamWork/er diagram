erDiagram
    %% =====================================================
    %% CORE BANKING STRUCTURE (KEEP)
    %% =====================================================
    ZONE ||--o{ REGION : contains
    REGION ||--o{ BRANCH : contains
    BRANCH ||--o{ EMPLOYEE : employs
    BRANCH ||--o{ ACCOUNT : maintains
    BRANCH ||--o{ CUSTOMER : serves

    %% =====================================================
    %% EMPLOYEE HIERARCHY (KEEP CORE)
    %% =====================================================
    DEPARTMENT ||--o{ EMPLOYEE : has
    DESIGNATION ||--o{ EMPLOYEE : has
    EMPLOYEE ||--o{ EMPLOYEE : manages

    %% =====================================================
    %% CUSTOMER MANAGEMENT (KEEP CORE)
    %% =====================================================
    CUSTOMERCATEGORY ||--o{ CUSTOMER : categorizes
    CUSTOMER ||--o{ CUSTOMERKYC : completes
    CUSTOMER ||--o{ NOMINEE : nominates

    %% =====================================================
    %% ACCOUNT MANAGEMENT (KEEP CORE)
    %% =====================================================
    ACCOUNTPRODUCT ||--o{ ACCOUNT : defines
    CUSTOMER ||--o{ ACCOUNT : owns
    ACCOUNT ||--o{ JOINTACCOUNTHOLDER : has
    ACCOUNT ||--o{ ACCOUNTBALANCEHISTORY : tracks

    %% =====================================================
    %% TRANSACTION SYSTEM (KEEP CORE)
    %% =====================================================
    TRANSACTIONTYPE ||--o{ TRANSACTION : defines
    ACCOUNT ||--o{ TRANSACTION : participates_in
    CUSTOMER ||--o{ TRANSACTION : initiates
    EMPLOYEE ||--o{ TRANSACTION : processes

    %% =====================================================
    %% LOAN MANAGEMENT (KEEP CORE)
    %% =====================================================
    LOANPRODUCT ||--o{ LOANAPPLICATION : offers
    CUSTOMER ||--o{ LOANAPPLICATION : applies
    EMPLOYEE ||--o{ LOANAPPLICATION : processes
    LOANAPPLICATION ||--o{ LOANACCOUNT : creates
    LOANACCOUNT ||--o{ LOANEMISCHEDULE : has
    LOANACCOUNT ||--o{ LOANPAYMENT : receives

    %% =====================================================
    %% DIGITAL BANKING (KEEP CORE)
    %% =====================================================
    CUSTOMER ||--o{ DIGITALBANKINGUSER : registers

    %% =====================================================
    %% BENEFICIARY & PAYMENTS (KEEP CORE)
    %% =====================================================
    CUSTOMER ||--o{ BENEFICIARY : maintains

    %% =====================================================
    %% COMPLAINTS (KEEP CORE)
    %% =====================================================
    COMPLAINTCATEGORY ||--o{ COMPLAINT : categorizes
    CUSTOMER ||--o{ COMPLAINT : raises
    ACCOUNT ||--o{ COMPLAINT : related_to
    EMPLOYEE ||--o{ COMPLAINT : resolves

    %% =====================================================
    %% CORE ENTITY DEFINITIONS ONLY
    %% =====================================================

    ZONE {
        int ZoneID PK
        string ZoneName
    }

    REGION {
        int RegionID PK
        string RegionName
        int ZoneID FK
    }

    BRANCH {
        int BranchID PK
        string BranchName
        string IFSCCode
        int ManagerEmployeeID FK
    }

    DEPARTMENT {
        int DepartmentID PK
        string DepartmentName
    }

    DESIGNATION {
        int DesignationID PK
        string DesignationName
    }

    EMPLOYEE {
        int EmployeeID PK
        string FirstName
        string LastName
        int DepartmentID FK
        int DesignationID FK
        int BranchID FK
    }

    CUSTOMERCATEGORY {
        int CategoryID PK
        string CategoryName
    }

    CUSTOMER {
        int CustomerID PK
        string FirstName
        string LastName
        int CustomerCategoryID FK
        int PrimaryBranchID FK
        int RelationshipManagerID FK
    }

    CUSTOMERKYC {
        int KYCID PK
        int CustomerID FK
        enum KYCStatus
    }

    NOMINEE {
        int NomineeID PK
        int CustomerID FK
        string NomineeName
        string NomineeRelation
    }

    ACCOUNTPRODUCT {
        int ProductID PK
        string ProductName
        enum AccountType
    }

    ACCOUNT {
        bigint AccountNumber PK
        int ProductID FK
        int CustomerID FK
        int BranchID FK
        decimal AvailableBalance
        enum AccountStatus
    }

    JOINTACCOUNTHOLDER {
        int JointHolderID PK
        bigint AccountNumber FK
        int CustomerID FK
    }

    ACCOUNTBALANCEHISTORY {
        int HistoryID PK
        bigint AccountNumber FK
        date BalanceDate
        decimal ClosingBalance
    }

    TRANSACTIONTYPE {
        int TransactionTypeID PK
        string TypeName
    }

    TRANSACTION {
        bigint TransactionID PK
        int TransactionTypeID FK
        decimal TransactionAmount
        date TransactionDate
        bigint FromAccountNumber FK
        bigint ToAccountNumber FK
        int FromCustomerID FK
        int ToCustomerID FK
        enum TransactionStatus
        int ProcessedBy FK
    }

    LOANPRODUCT {
        int ProductID PK
        string ProductName
    }

    LOANAPPLICATION {
        int ApplicationID PK
        int CustomerID FK
        int ProductID FK
        decimal LoanAmount
        enum ApplicationStatus
    }

    LOANACCOUNT {
        bigint LoanAccountNumber PK
        int ApplicationID FK
        decimal OutstandingPrincipal
        enum LoanStatus
    }

    LOANEMISCHEDULE {
        int ScheduleID PK
        bigint LoanAccountNumber FK
        date DueDate
        decimal EMIAmount
    }

    LOANPAYMENT {
        int PaymentID PK
        bigint LoanAccountNumber FK
        date PaymentDate
        decimal PaymentAmount
    }

    DIGITALBANKINGUSER {
        int UserID PK
        int CustomerID FK
        string Username
    }

    BENEFICIARY {
        int BeneficiaryID PK
        int CustomerID FK
        string BeneficiaryAccountNumber
        string BeneficiaryIFSC
    }

    COMPLAINTCATEGORY {
        int CategoryID PK
        string CategoryName
    }

    COMPLAINT {
        int ComplaintID PK
        int CustomerID FK
        bigint AccountNumber FK
        int CategoryID FK
        string Description
        enum Status
    }